# Application
APP_NAME="AI Job Hunter API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_job_hunter.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/ai_job_hunter

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Gmail Integration (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/email/callback

# Discord Integration
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
